<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".StoreListActivity">

    <TextView
        android:id="@+id/storesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:fontFamily="serif"
        android:text="My Beauty Stores"
        android:textColor="@color/dark_charcoal"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Search bar for filtering stores by name or beauty brand -->
    <SearchView
        android:id="@+id/storeSearchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:iconifiedByDefault="false"
        android:queryHint="Search stores or brands..."/>

    <!-- Displays the list of saved beauty stores -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/storesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Navigation button to return to the home menu -->
    <Button
        android:id="@+id/returnButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/rose_pink"
        android:text="← Back To Menu"
        android:textColor="@color/white" />

</LinearLayout>