<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/mainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="serif"
        android:text="Beauty Store Finder"
        android:textColor="@color/dark_charcoal"
        android:textColorLink="#9C27B0"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="start"
        android:text="Discover and save your favourite beauty stores"
        android:textColor="@color/dark_charcoal"
        android:textSize="16sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/viewStoresCard"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp" >

        <LinearLayout
            android:id="@+id/viewStoresCardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/viewStoresIconContainer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/soft_pink"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp" >

                <ImageView
                    android:id="@+id/viewStoresIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_shopping_bag_24" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/viewStoresTextContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/viewStoresTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="View Stores"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/viewStoresDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="See all saved beauty stores"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/viewStoresArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:gravity="center"
                android:text=">"
                android:textColor="@color/dark_charcoal"
                android:textSize="30sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/addStoreCard"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:id="@+id/addStoreCardContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/addStoreIconContainer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="@color/soft_pink"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/addStoreIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_add_store" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/addStoreTextContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/addStoreTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Add Store"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/addStoreDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Save a new beauty store"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/addStoreArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:gravity="center"
                android:text=">"
                android:textColor="@color/dark_charcoal"
                android:textSize="30sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>