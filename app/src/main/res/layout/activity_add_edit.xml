<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:backgroundTint="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="serif"
            android:text="Add Store"
            android:textColor="@color/dark_charcoal"
            android:textSize="36sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/rose_pink"
            android:ems="10"
            android:hint="Title"
            android:inputType="text"
            android:textColor="@color/dark_charcoal"
            android:textColorHint="@color/soft_pink" />

        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/rose_pink"
            android:ems="10"
            android:gravity="start|top"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:textColor="@color/dark_charcoal"
            android:textColorHint="@color/soft_pink" />

        <TextView
            android:id="@+id/categoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:text="Makeup Category"
            android:textColor="@color/rose_pink"
            android:textSize="14sp"
            android:textStyle="normal" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/rose_pink" />

        <EditText
            android:id="@+id/xInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/rose_pink"
            android:ems="10"
            android:hint="X Coordinate"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/dark_charcoal"
            android:textColorHint="@color/soft_pink" />

        <EditText
            android:id="@+id/yInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/rose_pink"
            android:ems="10"
            android:hint="Y Coordinate"
            android:inputType="numberDecimal|numberSigned"
            android:textColor="@color/dark_charcoal"
            android:textColorHint="@color/soft_pink" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/rose_pink"
            android:text="Save"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/soft_pink"
            android:text="Cancel"
            android:textColor="@color/dark_charcoal" />

    </LinearLayout>
</ScrollView>